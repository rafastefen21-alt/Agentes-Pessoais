# ──────────────────────────────────────────────────────────────
# Assistente pessoal com IA — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ──────────────────────────────────────────────────────────────

# Porta do servidor
PORT=3000
# URL PÚBLICA deste servidor (a Evolution chama o webhook aqui). Obrigatória.
# Local: use um túnel (ex.: cloudflared / ngrok) → https://xxxx.trycloudflare.com
# Railway: https://seu-app.up.railway.app
APP_URL=

# Senha do portal (obrigatória)
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar sessões e criptografar senhas de e-mail.
# Se vazio, é gerado e salvo em data/secret.key (não perca esse arquivo).
APP_SECRET=

# ── Banco de dados ──────────────────────────────────────────────
# Postgres do Supabase: Project Settings → Database → Connection string (URI).
# Use a opção "Transaction pooler" (porta 6543) — funciona em redes só-IPv4 como o Railway.
# Vazio = SQLite local em DATA_DIR (bom para testar; em produção use o Supabase).
DATABASE_URL=

# ── Evolution API (WhatsApp) ─────────────────────────────────────
EVOLUTION_URL=https://evolution-api-production-888b.up.railway.app
# AUTHENTICATION_API_KEY global da Evolution (precisa poder criar instâncias)
EVOLUTION_APIKEY=
# Token que vai na URL do webhook para validar que a chamada veio da Evolution
# (se vazio, usa APP_SECRET)
EVOLUTION_WEBHOOK_TOKEN=
# Prefixo dos nomes das instâncias criadas pelo portal
INSTANCE_PREFIX=assist

# ── Claude (IA) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Esforço de raciocínio: low | medium | high | xhigh | max
CLAUDE_TRIAGE_EFFORT=medium
CLAUDE_DIGEST_EFFORT=high
# Fallback automático para outro modelo se o Claude recusar (recomendado)
CLAUDE_FALLBACKS=true
# Cotação do dólar para mostrar os custos também em reais no portal (ex.: 5.40). 0 = só dólar.
USD_BRL_RATE=0

# ── Comportamento ───────────────────────────────────────────────
# Espera (ms) para juntar mensagens picadas da mesma conversa antes de triar
TRIAGE_DEBOUNCE_MS=60000
# Intervalo (ms) de leitura dos e-mails
EMAIL_POLL_MS=180000
# Intervalo (ms) de atualização da agenda
CALENDAR_POLL_MS=900000
# Ignorar grupos por padrão (configurável por pessoa no portal)
IGNORE_GROUPS_DEFAULT=true
# Marca no início das mensagens da assistente (para distinguir das da pessoa)
ASSISTANT_MARKER=🤖

LOG_LEVEL=info
DATA_DIR=data
